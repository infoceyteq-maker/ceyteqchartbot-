# Server-side address of the Ceyteq API (never exposed to the browser).
# In Docker Compose this is supplied automatically as http://api:<backend port>.
CEYTEQ_API_URL=http://127.0.0.1:8080
# Generate a unique random secret (at least 32 characters) before connecting.
CEYTEQ_SESSION_SECRET=replace-with-a-long-random-session-secret

# Baduma customer authentication (public project URL and publishable/anon key).
# Never put a Supabase service-role or secret key in NEXT_PUBLIC_* variables.
# Enable email magic links and/or an SMS provider in Supabase Auth. Add your
# deployed origin's /auth/callback URL to the Auth redirect allow list.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
