# Server-side address of the Ceyteq API (never exposed to the browser).
# In Docker Compose this is supplied automatically as http://api:<backend port>.
CEYTEQ_API_URL=http://127.0.0.1:8080
# Generate a unique random secret (at least 32 characters) before connecting.
CEYTEQ_SESSION_SECRET=replace-with-a-long-random-session-secret
